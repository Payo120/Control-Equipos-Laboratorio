<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.edu.uam.controlequiposlaboratorio.controller.EquipoController"
            prefWidth="950" prefHeight="620">

    <top>
        <VBox spacing="10" style="-fx-background-color: #1e293b; -fx-padding: 15;">
            <Label text="Control de Equipos de Laboratorio"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="310" style="-fx-padding: 15; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;">
            <Label text="Datos del Equipo" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <Label text="ID (Autogenerado):"/>
            <TextField fx:id="txtId" editable="false" disable="true" promptText="Generado automaticamente"/>

            <Label text="Codigo *:"/>
            <TextField fx:id="txtCodigo" promptText="Ej. EQ-009"/>

            <Label text="Nombre *:"/>
            <TextField fx:id="txtNombre" promptText="Nombre del equipo"/>

            <Label text="Marca:"/>
            <TextField fx:id="txtMarca" promptText="Marca del fabricante"/>

            <Label text="Cantidad *:"/>
            <TextField fx:id="txtCantidad" promptText="0 o mayor"/>

            <Label text="Tipo de Equipo *:"/>
            <ComboBox fx:id="cmbTipo" prefWidth="280" promptText="Seleccione un tipo"/>

            <Label text="Estado *:"/>
            <ComboBox fx:id="cmbEstado" prefWidth="280" promptText="Seleccione un estado"/>

            <HBox spacing="8" style="-fx-padding: 10 0 0 0;">
                <Button text="Guardar" onAction="#onGuardar" prefWidth="85" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Actualizar" onAction="#onActualizar" prefWidth="85" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Eliminar" onAction="#onEliminar" prefWidth="85" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
            <Button text="Limpiar Formulario / Restablecer" onAction="#onLimpiar" prefWidth="271"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" style="-fx-padding: 15;">
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f1f5f9; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="Buscar por nombre:"/>
                <TextField fx:id="txtBuscarNombre" promptText="Fragmento del nombre..." prefWidth="180"/>
                <Label text="Filtrar por tipo:"/>
                <ComboBox fx:id="cmbFiltroTipo" promptText="Todos los tipos" prefWidth="160"/>
                <Button text="Buscar / Aplicar filtros" onAction="#onBuscar" style="-fx-background-color: #0f172a; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tablaEquipos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="90"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colMarca" text="Marca" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                    <TableColumn fx:id="colTipo" text="Tipo de Equipo" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>